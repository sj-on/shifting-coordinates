<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {% set pageTitle = title if (title and title != site.title) else site.title %}
  {% set fullTitle = (title + " — " + site.title) if (title and title != site.title) else site.title %}
  {% set pageDescription = summary or site.description %}
  {% set pageUrl = site.url + page.url %}
  {% set pageImage = site.url + "/og-image.png" %}
  {% set isChapter = "chapter" in (tags or "") %}

  <title>{{ fullTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ pageUrl }}">
  <meta name="theme-color" content="#FF4FA3">

  <!-- open graph -->
  <meta property="og:type" content="{{ 'article' if isChapter else 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ pageImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <!-- twitter card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ pageImage }}">

  <!-- favicons -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="stylesheet" href="/css/style.css">

  {% if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.title }}",
    "description": "{{ site.description }}",
    "url": "{{ site.url }}"
  }
  </script>
  {% endif %}
</head>
<body>
  <header class="site-header">
    <a class="logo" href="/">{{ site.title }}</a>
  </header>
  <main class="wrap">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <p>made between upsc mock tests. no continents were harmed.</p>
  </footer>
</body>
</html>
