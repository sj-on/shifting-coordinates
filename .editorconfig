# see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# markdown sometimes uses trailing double-space for a line break — don't strip it
trim_trailing_whitespace = false

# note: editorconfig only covers whitespace/indentation, not letter casing.
# lowercase enforcement lives in scripts/check-lowercase.js (`npm run lint`).
